# Copy this file to .env on the server. Leave a value empty to keep that integration off.
# None of these are required for the editor or the API process to start.
# Do not prefix secrets with VITE_ or VITE_PUBLIC_. The Vite app does not read this file.

# Anthropic. Key: https://platform.claude.com/settings/keys
# Documented defaults checked 2026-11-25 at https://platform.claude.com/docs/en/models/overview
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_CREATIVE_MODEL=claude-fable-5-2
ANTHROPIC_CREATIVE_FALLBACKS=
ANTHROPIC_EXECUTION_MODEL=claude-sonnet-5-5
ANTHROPIC_EXECUTION_FALLBACKS=
ANTHROPIC_REVIEW_MODEL=claude-opus-5-5
ANTHROPIC_REVIEW_FALLBACKS=

# Fal. Key: https://fal.ai/dashboard/keys
# Image and video endpoint ids are unset until you choose one. This file does not pick one.
FAL_KEY=
FAL_IMAGE_MODEL=
FAL_VIDEO_MODEL=

# AssemblyAI. Dashboard: https://www.assemblyai.com/app
# EU accounts can set ASSEMBLYAI_BASE_URL=https://api.eu.assemblyai.com
# Speech model defaults checked 2026-11-25 at https://www.assemblyai.com/docs/pre-recorded-audio/select-the-speech-model
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_BASE_URL=
ASSEMBLYAI_SPEECH_MODEL=assemblyai-stt-3-7
ASSEMBLYAI_SPEECH_MODEL_FALLBACK=universal-2
ASSEMBLYAI_WEBHOOK_HEADER_NAME=
ASSEMBLYAI_WEBHOOK_HEADER_VALUE=

# OpenAI. Keys: https://platform.openai.com/api-keys
# File transcription default checked 2026-11-25 at https://developers.openai.com/api/docs/guides/transcription
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TRANSCRIPTION_FALLBACKS=

# auto uses AssemblyAI when its key is set, otherwise OpenAI. Or set assemblyai or openai.
TRANSCRIPTION_PROVIDER=auto

# Neon connection strings. Console: https://console.neon.tech
# Jobs in this stage use SQLite even when DATABASE_URL is set. The unpooled URL is stored for later migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Cloudflare R2. Tokens: https://developers.cloudflare.com/r2/api/tokens/
# Jurisdiction is eu, us, or fedramp. Leave it empty for the default endpoint.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_JURISDICTION=
R2_ENDPOINT=

# Trigger.dev. Keys: https://trigger.dev/docs/apikeys
# The default API origin is https://api.trigger.dev. Set TRIGGER_API_URL for a self-hosted instance.
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=

# Dedicated media worker. This stage queues work and can POST it. It does not run FFmpeg or Python here.
MEDIA_WORKER_URL=
MEDIA_WORKER_SECRET=
WEBHOOK_BASE_URL=

# Budgets are USD amounts. Empty means that limit is not enforced.
DEFAULT_PROJECT_BUDGET_USD=
MAX_RUN_SPEND_USD=
MAX_DAILY_SPEND_USD=
MAX_MONTHLY_SPEND_USD=

# Local process settings.
JOBS_DB_PATH=data/platform.sqlite
MEDIA_ROOT=data/media
PROVIDER_HEALTH_VERIFY=false
HOST=127.0.0.1
PORT=8787
